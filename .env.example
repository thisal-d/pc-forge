# ==============================================================================
# PCForge Master Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual credentials
# ==============================================================================

# ==============================================================================
# 1. BACKEND SERVICE & DATABASE (ASP.NET Core Web API / EF Core)
# ==============================================================================

# PostgreSQL Database Connection (Neon Serverless Cloud / Local PostgreSQL)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=pcforge_db;Username=postgres;Password=postgres
POSTGRES_DB=pcforge_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ASP.NET Core Runtime & Network
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5000
PORT=5000
ENABLE_SWAGGER=true
BACKEND_URL=http://localhost:5000
WEB_URL=http://localhost:5173

# JWT Authentication
Jwt__Key=your_jwt_secret_key_at_least_32_characters_long
Jwt__Issuer=PCForgeApi
Jwt__Audience=PCForgeClients

# CORS Allowed Frontend Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,https://pc-forge-admin.pages.dev,https://pc-forge-dev.pages.dev

# Inter-Service Communication Endpoint
AiService__BaseUrl=http://localhost:5050


# ==============================================================================
# 2. AI AGENT MICROSERVICE (Python FastAPI / LangChain / Google Gemini)
# ==============================================================================

GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_API_KEY_1=your_google_ai_studio_api_key_1
GOOGLE_API_KEY_2=your_google_ai_studio_api_key_2
GOOGLE_API_KEY_3=your_google_ai_studio_api_key_3
GOOGLE_API_KEY_4=your_google_ai_studio_api_key_4
GOOGLE_API_KEY_5=your_google_ai_studio_api_key_5

# Default Chat Model (gemini-2.5-flash-lite or gemini-2.5-flash)
CHAT_MODEL=gemini-2.5-flash-lite

# Embedding Model for Vector Retrieval (gemini-embedding-001 or text-embedding-004)
EMBEDDING_MODEL=gemini-embedding-001

# AI Microservice Runtime
AI_SERVICE_PORT=5050
AI_SERVICE_HOST=0.0.0.0


# ==============================================================================
# 3. REACT WEB PORTAL (Vite / React Staff Workbench)
# ==============================================================================

# Backend API Endpoint for Web Portal
VITE_API_BASE_URL=http://localhost:5000/api

# EmailJS Customer Notification Service (for custom PC build approval & change requests)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key


# ==============================================================================
# 4. FLUTTER MOBILE APP (Android / iOS / Windows Desktop Client)
# ==============================================================================

# Backend API Endpoint for Mobile App
# - Windows Desktop / adb reverse tunnel: http://localhost:5000/api
# - Android Emulator (standard loopback):  http://10.0.2.2:5000/api
# - Physical Android / iOS Phone (Wi-Fi): http://<YOUR_LOCAL_MACHINE_IP>:5000/api
API_BASE_URL=http://localhost:5000/api

# Mobile Environment Mode
APP_ENV=development


# ==============================================================================
# 5. THIRD-PARTY ASSET CLOUD STORAGE (Cloudinary CDN)
# ==============================================================================

# Cloudinary Storage for Hardware Product Images & Customer Ticket Photos
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
