# ==============================================================================
# PCForge Mobile App Environment Configuration Template (.env.example)
# Copy to app/.env and configure your values.
# ==============================================================================

# Backend API Endpoint for Mobile App
# - Windows Desktop / adb reverse tunnel: http://localhost:5000/api
# - Android Emulator (standard loopback):  http://10.0.2.2:5000/api
# - Physical Android / iOS Phone (Wi-Fi): http://<YOUR_LOCAL_MACHINE_IP>:5000/api
API_BASE_URL=http://localhost:5000/api

# Mobile Environment Mode
APP_ENV=development
