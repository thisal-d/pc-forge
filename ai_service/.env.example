# ==============================================================================
# PCForge AI Agent Microservice Environment Configuration Template (.env.example)
# Copy to ai_service/.env and set your Gemini API key(s)
# ==============================================================================

# Google Gemini API Keys (Multi-key cascading fallback chain 1 -> 6)
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4
GEMINI_API_KEY_5=your_gemini_api_key_5
GEMINI_API_KEY_6=your_gemini_api_key_6

# Gemini Models
CHAT_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001

# AI Service Network Configuration
AI_SERVICE_PORT=5050
AI_SERVICE_HOST=0.0.0.0

# Backend Web API URL
BACKEND_URL=http://localhost:5000
