# ==============================================================================
# PCForge Backend Service Environment Configuration Template (.env.example)
# Copy to backend/.env and populate with your local / cloud credentials.
# ==============================================================================

# PostgreSQL Database Connection
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=pcforge_db;Username=postgres;Password=postgres

# Server & Runtime Configuration
PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# JWT Authentication
Jwt__Key=your_jwt_secret_key_at_least_32_characters_long
Jwt__Issuer=PCForgeApi
Jwt__Audience=PCForgeClients

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,https://pc-forge-admin.pages.dev,https://pc-forge-dev.pages.dev

# AI Microservice Inter-Service Communication Endpoint
AiService__BaseUrl=http://localhost:5050

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client Web App URL (for email links and redirects)
WEB_URL=http://localhost:5173

# Email Notification Service (EmailJS REST API)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_optional_emailjs_private_key

# Master Workflow Template IDs (EmailJS Free Tier: 2 templates; Service Requests fall back to PC Build template)
EMAILJS_PC_BUILD_REVIEW_TEMPLATE_ID=your_pc_build_template_id
EMAILJS_ORDER_STATUS_TEMPLATE_ID=your_order_status_template_id
# EMAILJS_SERVICE_REQUEST_TEMPLATE_ID=your_optional_service_request_template_id

# Legacy Fallback
EMAILJS_TEMPLATE_ID=your_legacy_template_id

# Optional Granular Event Template ID Overrides (Leave blank to use Master Templates above)
# EMAILJS_BUILD_SUBMITTED_TEMPLATE_ID=
# EMAILJS_BUILD_IN_REVIEW_TEMPLATE_ID=
# EMAILJS_BUILD_APPROVED_TEMPLATE_ID=
# EMAILJS_BUILD_CHANGES_REQUESTED_TEMPLATE_ID=
# EMAILJS_BUILD_CANCELLED_TEMPLATE_ID=
# EMAILJS_ORDER_PLACED_TEMPLATE_ID=
# EMAILJS_ORDER_PROCESSING_TEMPLATE_ID=
# EMAILJS_ORDER_READY_PICKUP_TEMPLATE_ID=
# EMAILJS_ORDER_OUT_FOR_DELIVERY_TEMPLATE_ID=
# EMAILJS_ORDER_COMPLETED_TEMPLATE_ID=
# EMAILJS_ORDER_CANCELLED_TEMPLATE_ID=
# EMAILJS_SERVICE_RECEIVED_TEMPLATE_ID=
# EMAILJS_SERVICE_IN_PROGRESS_TEMPLATE_ID=
# EMAILJS_SERVICE_COMPLETED_TEMPLATE_ID=
# EMAILJS_SERVICE_REJECTED_TEMPLATE_ID=
# EMAILJS_SERVICE_CANCELLED_TEMPLATE_ID=

