# ==============================================================================
# PCForge Backend Service Environment Configuration Template (.env.example)
# Copy to backend/.env and populate with your local / cloud credentials.
# ==============================================================================

# PostgreSQL Database Connection
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=pcforge_db;Username=postgres;Password=postgres

# Server & Runtime Configuration
PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# JWT Authentication
Jwt__Key=your_jwt_secret_key_at_least_32_characters_long
Jwt__Issuer=PCForgeApi
Jwt__Audience=PCForgeClients

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,https://pc-forge-admin.pages.dev,https://pc-forge-dev.pages.dev

# AI Microservice Inter-Service Communication Endpoint
AiService__BaseUrl=http://localhost:5050

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Notification Service (EmailJS REST API for custom build reviews)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_optional_emailjs_private_key

